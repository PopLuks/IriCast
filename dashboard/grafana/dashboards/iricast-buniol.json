    {
      "type": "state-timeline",
      "title": "Indicatori risc seceta (0 = umed, 1 = secetos, -1 = date insuficiente)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "iricast-db" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT hour AS time, COALESCE((dry_ref)::int, -1) AS \"referinta (precip 72h)\", COALESCE((dry_multi)::int, -1) AS \"multi-indicator\" FROM v_drought WHERE station='buniol' AND $__timeFilter(hour) ORDER BY hour"
        }
      ],
      "fieldConfig": { "defaults": { "custom": {} }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "mergeValues": true }
    },
    {
      "type": "table",
      "title": "Acoperire date per senzor (interval selectat)",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 25 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "iricast-db" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sensor, count(value) AS \"valori ok\", count(*) FILTER (WHERE quality='missing') AS \"valori lipsa\", min(ts) AS \"prima masuratoare\", max(ts) AS \"ultima masuratoare\" FROM measurements WHERE station='buniol' AND $__timeFilter(ts) GROUP BY sensor ORDER BY sensor"
        }
      ],
      "options": { "showHeader": true }
    },
    {
      "type": "table",
      "title": "Sumar indicatori de seceta (interval selectat)",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 25 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "iricast-db" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE dry_ref) AS \"ore secetoase (referinta)\", count(*) FILTER (WHERE dry_multi) AS \"ore risc (multi-indicator)\", count(*) FILTER (WHERE dry_ref AND dry_multi) AS \"ambele\", count(*) FILTER (WHERE dry_ref AND NOT dry_multi) AS \"doar referinta\", count(*) FILTER (WHERE NOT dry_ref AND dry_multi) AS \"doar multi\", count(*) FILTER (WHERE dry_ref IS NULL OR dry_multi IS NULL) AS \"ore date insuficiente\" FROM v_drought WHERE station='buniol' AND $__timeFilter(hour)"
        }
      ],
      "options": { "showHeader": true }
    }
  ]
